parameters:
    level: 8

    paths:
        - src/
        - tests/

    scanFiles:
        - smooth-restaurant.php
        - uninstall.php

    bootstrapFiles:
        - smooth-restaurant.php

    excludePaths:
        - vendor/*
        - node_modules/*

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # PHPUnit static assertions called dynamically are valid in test context
        # (house style uses $this->assert*() throughout the suites).
        - message: '#Dynamic call to static method PHPUnit\\Framework\\Assert::#'
          path: tests/*
