# Copy to `.env` (same folder, gitignored) and fill in. Never commit `.env`.
# Only `.env` loads in Bruno — this file is structure documentation only.

# WordPress login holding the caps under test (matches wpUsername in environments/local.yml).
SMOOTH_WP_USERNAME=admin

# WordPress Application Password (Users → Profile → Application Passwords).
# Basic-auth password for a user holding the caps under test. Local use only.
SMOOTH_APP_PASSWORD=

# Optional: override the site URL without editing environments/local.yml
SMOOTH_BASE_URL=http://localhost:8889
